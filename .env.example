# --- Models -------------------------------------------------------------------
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5
GUARD_MODEL=claude-haiku-5-5

# --- Guardrail limits ---------------------------------------------------------
MAX_STEPS_PER_TURN=12          # agent steps between two user messages before escalating
MAX_IDENTICAL_CALLS=2          # same tool + same args more than this -> escalate (loop)
MAX_BLOCKED_RETRIES=3          # consecutive fully-blocked steps before escalating

# --- Human sign-off -----------------------------------------------------------
APPROVAL_MODE=human            # human | auto_approve | auto_deny (auto_* only for benchmarks)
APPROVAL_TIMEOUT_S=900         # Temporal: deny + escalate if nobody decides in time
OPERATOR_TOKEN=change-me       # API: operators send X-Operator-Token and X-Reviewer

# --- State --------------------------------------------------------------------
CHECKPOINT_URL=sqlite:///checkpoints.db     # postgresql://user:pass@host/db on Cloud Run
TOOLS_MCP_URL=                               # e.g. http://tools:8001/mcp ; empty = in-process demo tools

# --- Observability ------------------------------------------------------------
ARIZE_SPACE_ID=
ARIZE_API_KEY=
ARIZE_PROJECT=support-agent
TRACE_DIR=traces

# --- Temporal (optional) ------------------------------------------------------
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=support-agent
